# Optional WalletConnect project id (enables the WalletConnect QR connector).
NUXT_PUBLIC_EVM_WALLET_CONNECT_PROJECT_ID=

# Optional public read RPC(s) for mainnet, space separated. Falls back to the
# defaults in nuxt.config.ts. Wallet writes never use these.
# NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPCS=https://eth.llamarpc.com

# Optional: override the deployed BatchTransfer address for the active chain.
# NUXT_PUBLIC_BATCH_TRANSFER_ADDRESS=0x...
